@@ -0,0 +1,74 @@
+package baseline.policy
+
+import rego.v1
+
+anchor := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+
+valid_input := {
+	"baseline_anchor": anchor,
+	"bundle_digest": anchor,
+	"policy_decision": "PASS",
+	"risk_status": "ACCEPTABLE",
+	"seal_status": "ACTIVE",
+	"evidence_age_hours": 24,
+}
+
+test_complete_acceptable_bundle_allowed if {
+	allow with input as valid_input
+}
+
+test_missing_or_invalid_anchor_denied if {
+	missing := object.remove(valid_input, ["baseline_anchor"])
+	not allow with input as missing
+	invalid := object.union(valid_input, {"baseline_anchor": "not-a-digest"})
+	not allow with input as invalid
+}
+
+test_policy_fail_or_missing_denied if {
+	failed := object.union(valid_input, {"policy_decision": "FAIL"})
+	not allow with input as failed
+	absent := object.remove(valid_input, ["policy_decision"])
+	not allow with input as absent
+}
+
+test_stale_evidence_rules if {
+	stale := object.union(valid_input, {"evidence_age_hours": 121})
+	not allow with input as stale
+	exempt := object.union(valid_input, {"evidence_age_hours": 121, "staleness_exemption": true})
+	allow with input as exempt
+	fresh := object.union(valid_input, {"evidence_age_hours": 120})
+	allow with input as fresh
+}
+
+test_seal_lifecycle_denied if {
+	expired := object.union(valid_input, {"seal_status": "EXPIRED"})
+	not allow with input as expired
+	revoked := object.union(valid_input, {"seal_status": "REVOKED"})
+	not allow with input as revoked
+	missing := object.remove(valid_input, ["seal_status"])
+	not allow with input as missing
+}
+
+test_unacceptable_risk_denied if {
+	bad := object.union(valid_input, {"risk_status": "UNACCEPTABLE"})
+	not allow with input as bad
+	unknown := object.union(valid_input, {"risk_status": "MAYBE"})
+	not allow with input as unknown
+}
+
+test_conditional_acceptance_gates if {
+	base := object.union(valid_input, {"risk_status": "CONDITIONALLY_ACCEPTABLE"})
+	not allow with input as base
+	complete := object.union(base, {
+		"ao_approval": true,
+		"compensating_controls": ["C-0001 RBAC-enforced read-only ledger"],
+		"remediation_sla_hours": 72,
+		"expiry": "2027-01-01T00:00:00Z",
+		"ledger_anchor": anchor,
+	})
+	allow with input as complete
+	incomplete := object.union(complete, {"ao_approval": false})
+	not allow with input as incomplete
+	oversla := object.union(complete, {"remediation_sla_hours": 121})
+	not allow with input as oversla
+}
