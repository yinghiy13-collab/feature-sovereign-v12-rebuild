diff --git a/policy/baseline.rego b/policy/baseline.rego
new file mode 100644
index 0000000..d56dc1d
--- /dev/null
+++ b/policy/baseline.rego
@@ -0,0 +1,79 @@
+# Policy Agent evaluates ONLY. It never records, seals, or authorizes.
+# Fail-closed: any missing or invalid input denies.
+
+package baseline.policy
+
+import rego.v1
+
+default allow := false
+
+SLA_HOURS := 120
+
+valid_sha256(value) if {
+	is_string(value)
+	regex.match(`^[0-9a-fA-F]{64}$`, value)
+}
+
+# A1: missing baseline anchor
+deny contains "missing baseline anchor" if {
+	not input.baseline_anchor
+}
+
+# A2: anchor is not a well-formed sha256 digest
+deny contains "baseline anchor is not a valid sha256 digest" if {
+	input.baseline_anchor
+	not valid_sha256(input.baseline_anchor)
+}
+
+# B: policy decision absent or unknown
+deny contains "missing or unknown policy decision" if {
+	not input.policy_decision in {"PASS", "FAIL"}
+}
+
+# C: explicit policy failure
+deny contains "policy evaluation failed" if {
+	input.policy_decision == "FAIL"
+}
+
+# D: stale evidence beyond 120h SLA without exemption
+deny contains "evidence stale beyond 120h SLA without exemption" if {
+	is_number(input.evidence_age_hours)
+	input.evidence_age_hours > SLA_HOURS
+	not input.staleness_exemption
+}
+
+# E: seal missing, expired, or revoked
+deny contains "seal missing, expired, or revoked" if {
+	not input.seal_status == "ACTIVE"
+}
+
+# F: unacceptable risk
+deny contains "risk classification is UNACCEPTABLE" if {
+	input.risk_status == "UNACCEPTABLE"
+}
+
+# F2: unknown risk classification (fail-closed)
+deny contains "missing or unknown risk status" if {
+	not input.risk_status in {"ACCEPTABLE", "CONDITIONALLY_ACCEPTABLE", "UNACCEPTABLE"}
+}
+
+# G: conditional acceptance without all five required elements
+deny contains "conditional acceptance missing required elements" if {
+	input.risk_status == "CONDITIONALLY_ACCEPTABLE"
+	not conditional_acceptance_complete
+}
+
+conditional_acceptance_complete if {
+	input.ao_approval == true
+	is_array(input.compensating_controls)
+	count(input.compensating_controls) > 0
+	is_number(input.remediation_sla_hours)
+	input.remediation_sla_hours > 0
+	input.remediation_sla_hours <= SLA_HOURS
+	input.expiry
+	valid_sha256(input.ledger_anchor)
+}
+
+allow if {
+	count(deny) == 0
+}
