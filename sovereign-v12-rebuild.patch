@@ -0,0 +1,65 @@
+"""Schema conformance tests (unittest style; pytest collects these too)."""
+import json
+import sys
+import unittest
+from pathlib import Path
+
+from jsonschema import Draft202012Validator
+
+ROOT = Path(__file__).resolve().parents[1]
+BUNDLE_SCHEMA = json.loads((ROOT / "schemas" / "evidence_bundle.schema.json").read_text(encoding="utf-8"))
+RISK_SCHEMA = json.loads((ROOT / "schemas" / "risk_record.schema.json").read_text(encoding="utf-8"))
+
+DIGEST = "ab" * 32
+
+
+def valid_bundle():
+    return {
+        "bundle_id": "B-TEST-0001",
+        "bundle_digest": DIGEST,
+        "baseline_anchor": DIGEST,
+        "members": [{"member_id": "m1", "sha256": DIGEST, "role": "policy"}],
+        "policy_decision": "PASS",
+        "risk_status": "ACCEPTABLE",
+        "seal_status": "ACTIVE",
+        "auditor_signoff": {"auditor": "auditor-1", "signed": True, "signed_at": "2026-11-01T00:00:00Z"},
+        "evidence_age_hours": 24,
+    }
+
+
+class EvidenceBundleSchemaTests(unittest.TestCase):
+    def test_valid_bundle_passes(self):
+        errors = list(Draft202012Validator(BUNDLE_SCHEMA).iter_errors(valid_bundle()))
+        self.assertEqual(errors, [])
+
+    def test_missing_required_field_fails(self):
+        bundle = valid_bundle()
+        del bundle["seal_status"]
+        errors = list(Draft202012Validator(BUNDLE_SCHEMA).iter_errors(bundle))
+        self.assertTrue(errors, "missing seal_status must fail validation")
+
+    def test_malformed_digest_fails(self):
+        bundle = valid_bundle()
+        bundle["bundle_digest"] = "not-a-digest"
+        errors = list(Draft202012Validator(BUNDLE_SCHEMA).iter_errors(bundle))
+        self.assertTrue(errors, "malformed bundle_digest must fail validation")
+
+
+class RiskRecordSchemaTests(unittest.TestCase):
+    def test_valid_risk_record_passes_and_bad_classification_fails(self):
+        record = {
+            "risk_id": "RISK-0001",
+            "title": "Unpinned build dependency",
+            "classification": "PENDING_REVIEW",
+            "likelihood": "MEDIUM",
+            "impact": "HIGH",
+            "owner": "Operator",
+            "status": "OPEN",
+        }
+        self.assertEqual(list(Draft202012Validator(RISK_SCHEMA).iter_errors(record)), [])
+        bad = dict(record, classification="FINE_PROBABLY")
+        self.assertTrue(list(Draft202012Validator(RISK_SCHEMA).iter_errors(bad)))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_release_gate.py b/tests/test_release_gate.py
new file mode 100644
index 0000000..c43f2d3
--- /dev/null
+++ b/tests/test_release_gate.py
@@ -0,0 +1,163 @@
+"""Release gate tests -- 14 cases (unittest style; pytest collects these too).
+
+Builds bundles via the same helpers as gate_check so digests/chains are
+consistent. Only synthetic digests are used; no real anchors or approvals.
+"""
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools" / "release"))
+import gate_check as gc  # noqa: E402
+
+ANCHOR = "cd" * 32
+
+
+def make_member(member_id, prev, payload=""):
+    sha = gc.canonical_sha256({"prev": prev, "member_id": member_id, "payload": payload})
+    return {"member_id": member_id, "prev": prev, "sha256": sha, "payload": payload}
+
+
+def make_bundle(**overrides):
+    m1 = make_member("m1", ANCHOR)
+    m2 = make_member("m2", m1["sha256"])
+    bundle = {
+        "bundle_id": "B-TEST-0001",
+        "baseline_anchor": ANCHOR,
+        "members": [m1, m2],
+        "policy_decision": "PASS",
+        "risk_status": "ACCEPTABLE",
+        "seal_status": "ACTIVE",
+        "auditor_signoff": {"auditor": "auditor-1", "signed": True, "signed_at": "2026-11-01T00:00:00Z"},
+        "evidence_age_hours": 24,
+    }
+    bundle.update(overrides)
+    if "bundle_digest" not in overrides:
+        bundle["bundle_digest"] = gc.expected_bundle_digest(bundle)
+    return bundle
+
+
+class ReleaseGateTests(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.dir = Path(self._tmp.name)
+
+    def write_bundle(self, bundle):
+        path = self.dir / "bundle.json"
+        path.write_text(json.dumps(bundle), encoding="utf-8")
+        return str(path)
+
+    def evaluate(self, bundle):
+        return gc.evaluate(bundle) if isinstance(bundle, dict) else gc.evaluate(json.loads(bundle))
+
+    # 1
+    def test_valid_full_bundle_allows(self):
+        allowed, reasons = self.evaluate(make_bundle())
+        self.assertTrue(allowed, f"expected ALLOW, got {reasons}")
+
+    # 2
+    def test_missing_anchor_denies(self):
+        bundle = make_bundle()
+        del bundle["baseline_anchor"]
+        bundle["bundle_digest"] = gc.expected_bundle_digest(bundle)
+        allowed, reasons = self.evaluate(bundle)
+        self.assertFalse(allowed)
+        self.assertTrue(any("anchor" in r for r in reasons))
+
+    # 3
+    def test_malformed_anchor_denies(self):
+        allowed, reasons = self.evaluate(make_bundle(baseline_anchor="not-a-digest"))
+        self.assertFalse(allowed)
+
+    # 4
+    def test_fail_policy_denies(self):
+        allowed, reasons = self.evaluate(make_bundle(policy_decision="FAIL"))
+        self.assertFalse(allowed)
+        self.assertTrue(any("policy" in r for r in reasons))
+
+    # 5
+    def test_expired_or_revoked_seal_denies(self):
+        for status in ("EXPIRED", "REVOKED", "NONE"):
+            allowed, _ = self.evaluate(make_bundle(seal_status=status))
+            self.assertFalse(allowed, f"seal_status={status} must DENY")
+
+    # 6
+    def test_missing_auditor_signoff_denies(self):
+        allowed, reasons = self.evaluate(make_bundle(auditor_signoff=None))
+        self.assertFalse(allowed)
+        self.assertTrue(any("signoff" in r for r in reasons))
+
+    # 7
+    def test_unsigned_signoff_denies(self):
+        allowed, _ = self.evaluate(make_bundle(auditor_signoff={"auditor": "auditor-1", "signed": False}))
+        self.assertFalse(allowed)
+
+    # 8
+    def test_unacceptable_risk_denies(self):
+        allowed, reasons = self.evaluate(make_bundle(risk_status="UNACCEPTABLE"))
+        self.assertFalse(allowed)
+        self.assertTrue(any("UNACCEPTABLE" in r for r in reasons))
+
+    # 9
+    def test_broken_chain_denies(self):
+        bundle = make_bundle()
+        bundle["members"][1]["prev"] = "ef" * 32  # wrong link
+        allowed, reasons = self.evaluate(bundle)
+        self.assertFalse(allowed)
+        self.assertTrue(any("chain" in r for r in reasons))
+
+    # 10
+    def test_digest_mismatch_denies(self):
+        allowed, reasons = self.evaluate(make_bundle(bundle_digest="ab" * 32))
+        self.assertFalse(allowed)
+        self.assertTrue(any("digest" in r for r in reasons))
+
+    # 11
+    def test_non_finite_numeric_denies(self):
+        raw = json.dumps(make_bundle()).replace('"evidence_age_hours": 24', '"evidence_age_hours": Infinity')
+        path = self.write_bundle_raw(raw)
+        with self.assertRaises(ValueError):
+            gc.load_bundle(path)
+        exit_code = gc.main([path])
+        # main catches the parse error and DENYs
+        self.assertEqual(exit_code, 1)
+
+    def write_bundle_raw(self, raw):
+        path = self.dir / "raw.json"
+        path.write_text(raw, encoding="utf-8")
+        return str(path)
+
+    # 12
+    def test_conditional_acceptable_incomplete_denies(self):
+        allowed, reasons = self.evaluate(make_bundle(risk_status="CONDITIONALLY_ACCEPTABLE"))
+        self.assertFalse(allowed)
+        self.assertTrue(len(reasons) >= 4, "all missing conditional elements must be reported")
+
+    # 13
+    def test_conditional_acceptable_complete_allows(self):
+        bundle = make_bundle(
+            risk_status="CONDITIONALLY_ACCEPTABLE",
+            ao_approval=True,
+            compensating_controls=["C-0001 read-only enforcement"],
+            remediation_sla_hours=72,
+            expiry="2027-01-01T00:00:00Z",
+            ledger_anchor="ef" * 32,
+        )
+        allowed, reasons = self.evaluate(bundle)
+        self.assertTrue(allowed, f"expected ALLOW, got {reasons}")
+
+    # 14
+    def test_placeholder_example_denies(self):
+        placeholder = ROOT / "examples" / "placeholder_evidence_bundle.json"
+        allowed, reasons = gc.evaluate(gc.load_bundle(str(placeholder)))
+        self.assertFalse(allowed)
+        self.assertTrue(reasons)
+        self.assertEqual(gc.main([str(placeholder)]), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
