+#!/usr/bin/env python3
+"""Release gate check -- evaluates ONLY, read-only, fail-closed.
+
+Usage: gate_check.py <evidence_bundle.json>
+
+Outputs ALLOW (exit 0) or DENY: <reasons> (exit 1). Parse errors also DENY.
+This tool never writes to disk and never mints approvals, seals, or anchors.
+"""
+import hashlib
+import json
+import math
+import re
+import sys
+
+SHA256_RE = re.compile(r"^[0-9a-fA-F]{64}$")
+SLA_HOURS = 120
+NUMERIC_FIELDS = ("evidence_age_hours", "remediation_sla_hours")
+
+
+def load_bundle(path):
+    """Strict JSON parse: NaN/Infinity literals are rejected."""
+    def _bad_constant(text):
+        raise ValueError(f"non-finite numeric literal: {text}")
+    with open(path, "r", encoding="utf-8") as fh:
+        return json.load(fh, parse_constant=_bad_constant)
+
+
+def canonical_sha256(obj):
+    blob = json.dumps(obj, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(blob).hexdigest()
+
+
+def expected_bundle_digest(bundle):
+    return canonical_sha256({
+        "baseline_anchor": bundle.get("baseline_anchor"),
+        "members": bundle.get("members"),
+    })
+
+
+def check_chain(bundle):
+    """Hash chain: genesis prev = baseline_anchor; each member links to the previous."""
+    members = bundle.get("members")
+    if not isinstance(members, list) or not members:
+        return [ "evidence chain empty" ]
+    reasons = []
+    prev = str(bundle.get("baseline_anchor", "")).lower()
+    for index, member in enumerate(members):
+        if not isinstance(member, dict):
+            reasons.append(f"member {index} is not an object")
+            continue
+        digest = member.get("sha256", "")
+        if not SHA256_RE.match(str(digest)):
+            reasons.append(f"member {index} has malformed sha256")
+            continue
+        if str(member.get("prev", "")).lower() != prev:
+            reasons.append(f"member {index} breaks the evidence chain")
+        prev = str(digest).lower()
+    return reasons
+
+
+def finite_numeric_fields(bundle):
+    reasons = []
+    for field in NUMERIC_FIELDS:
+        value = bundle.get(field)
+        if value is None:
+            continue
+        if not isinstance(value, (int, float)) or isinstance(value, bool):
+            reasons.append(f"{field} is not numeric")
+        elif not math.isfinite(value):
+            reasons.append(f"{field} is not finite")
+    return reasons
+
+
+def evaluate(bundle):
+    """Return (allowed, reasons). Fail-closed: any problem denies."""
+    if not isinstance(bundle, dict):
+        return False, ["bundle is not a JSON object"]
+
+    reasons = []
+
+    anchor = bundle.get("baseline_anchor")
+    if not anchor:
+        reasons.append("missing baseline anchor")
+    elif not SHA256_RE.match(str(anchor)):
+        reasons.append("baseline anchor is not a valid sha256 digest")
+
+    digest = bundle.get("bundle_digest")
+    if not digest:
+        reasons.append("missing bundle digest")
+    elif not SHA256_RE.match(str(digest)):
+        reasons.append("bundle digest is not a valid sha256 digest")
+    elif SHA256_RE.match(str(anchor) if anchor else ""):
+        if str(digest).lower() != expected_bundle_digest(bundle):
+            reasons.append("bundle digest mismatch (anchor/members recompute failed)")
+
+    reasons.extend(check_chain(bundle))
+    reasons.extend(finite_numeric_fields(bundle))
+
+    if bundle.get("policy_decision") != "PASS":
+        reasons.append("policy decision is not PASS")
+
+    risk = bundle.get("risk_status")
+    if risk == "UNACCEPTABLE":
+        reasons.append("risk classification is UNACCEPTABLE")
+    elif risk == "CONDITIONALLY_ACCEPTABLE":
+        if bundle.get("ao_approval") is not True:
+            reasons.append("conditional acceptance missing AO approval")
+        controls = bundle.get("compensating_controls")
+        if not isinstance(controls, list) or not controls:
+            reasons.append("conditional acceptance missing compensating controls")
+        sla = bundle.get("remediation_sla_hours")
+        if not isinstance(sla, (int, float)) or isinstance(sla, bool) or not math.isfinite(sla) or sla <= 0 or sla > SLA_HOURS:
+            reasons.append(f"conditional acceptance missing valid remediation SLA (0 < sla <= {SLA_HOURS}h)")
+        if not bundle.get("expiry"):
+            reasons.append("conditional acceptance missing expiry")
+        ledger = bundle.get("ledger_anchor")
+        if not ledger or not SHA256_RE.match(str(ledger)):
+            reasons.append("conditional acceptance missing ledger anchor")
+    elif risk != "ACCEPTABLE":
+        reasons.append("missing or unknown risk status")
+
+    if bundle.get("seal_status") != "ACTIVE":
+        reasons.append(f"seal not ACTIVE (seal_status={bundle.get('seal_status')!r})")
+
+    signoff = bundle.get("auditor_signoff")
+    if not isinstance(signoff, dict) or not signoff.get("signed") or not signoff.get("auditor"):
+        reasons.append("missing auditor signoff")
+
+    age = bundle.get("evidence_age_hours")
+    if isinstance(age, (int, float)) and not isinstance(age, bool) and math.isfinite(age):
+        if age > SLA_HOURS and not bundle.get("staleness_exemption"):
+            reasons.append(f"evidence stale beyond {SLA_HOURS}h SLA without exemption")
+
+    return (len(reasons) == 0), reasons
+
+
+def main(argv=None):
+    argv = argv if argv is not None else sys.argv[1:]
+    if len(argv) != 1:
+        print("usage: gate_check.py <evidence_bundle.json>", file=sys.stderr)
+        return 2
+    try:
+        bundle = load_bundle(argv[0])
+    except (OSError, ValueError, json.JSONDecodeError) as exc:
+        print(f"DENY: unreadable bundle: {exc}")
+        return 1
+    allowed, reasons = evaluate(bundle)
+    if allowed:
+        print("ALLOW")
+        return 0
+    print("DENY: " + "; ".join(reasons))
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
