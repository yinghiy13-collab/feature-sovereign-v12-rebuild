@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Read-only audit dashboard for evidence bundles.
+
+Four views: Matrix, Timeline Replay, Risk Register, Seal Lifecycle.
+Evaluates/prints only -- this tool NEVER writes to disk or network.
+"""
+import argparse
+import json
+import sys
+
+VIEWS = ("matrix", "timeline", "risk", "seal")
+
+
+def load_bundle(path):
+    with open(path, "r", encoding="utf-8") as fh:
+        return json.load(fh)
+
+
+def view_matrix(bundle):
+    print("== Matrix View ==")
+    rows = [
+        ("bundle_id", bundle.get("bundle_id")),
+        ("baseline_anchor", bundle.get("baseline_anchor")),
+        ("bundle_digest", bundle.get("bundle_digest")),
+        ("policy_decision", bundle.get("policy_decision")),
+        ("risk_status", bundle.get("risk_status")),
+        ("seal_status", bundle.get("seal_status")),
+        ("auditor_signed", (bundle.get("auditor_signoff") or {}).get("signed")),
+    ]
+    width = max(len(k) for k, _ in rows)
+    for key, value in rows:
+        print(f"  {key:<{width}} : {value}")
+    members = bundle.get("members") or []
+    print(f"  members                : {len(members)}")
+    for m in members:
+        print(f"    - {m.get('member_id')}: {m.get('sha256', '<no digest>')[:16]}... role={m.get('role', '-')}")
+
+
+def view_timeline(bundle):
+    print("== Timeline Replay ==")
+    events = []
+    for m in bundle.get("members") or []:
+        if m.get("captured_at"):
+            events.append((m["captured_at"], f"member captured: {m.get('member_id')}"))
+    signoff = bundle.get("auditor_signoff") or {}
+    if signoff.get("signed_at"):
+        events.append((signoff["signed_at"], f"auditor signoff: {signoff.get('auditor')}"))
+    for key in ("sealed_at", "expires", "expiry"):
+        if bundle.get(key):
+            events.append((bundle[key], f"{key}"))
+    if bundle.get("evidence_age_hours") is not None:
+        events.append((f"age={bundle['evidence_age_hours']}h", "staleness check (SLA 120h)"))
+    if not events:
+        print("  (no timestamped events in bundle)")
+        return
+    for ts, desc in sorted(events, key=lambda e: str(e[0])):
+        print(f"  {ts}  {desc}")
+
+
+def view_risk(bundle):
+    print("== Risk Register ==")
+    print(f"  risk_status           : {bundle.get('risk_status')}")
+    if bundle.get("risk_status") == "CONDITIONALLY_ACCEPTABLE":
+        print(f"  ao_approval           : {bundle.get('ao_approval')}")
+        controls = bundle.get("compensating_controls") or []
+        print(f"  compensating_controls : {len(controls)}")
+        for c in controls:
+            print(f"    - {c}")
+        print(f"  remediation_sla_hours : {bundle.get('remediation_sla_hours')}")
+        print(f"  expiry                : {bundle.get('expiry')}")
+        print(f"  ledger_anchor         : {bundle.get('ledger_anchor')}")
+    for record in bundle.get("risk_records") or []:
+        print(f"  {record.get('risk_id')}: {record.get('title')} [{record.get('classification')}] owner={record.get('owner')} status={record.get('status')}")
+
+
+def view_seal(bundle):
+    print("== Seal Lifecycle ==")
+    print(f"  seal_status : {bundle.get('seal_status')}")
+    for key in ("seal_id", "sealed_at", "expires", "revoked_at"):
+        if bundle.get(key):
+            print(f"  {key:<11}: {bundle[key]}")
+    status = bundle.get("seal_status")
+    if status == "ACTIVE":
+        print("  seal is ACTIVE")
+    else:
+        print(f"  seal NOT active ({status}) -- gate will DENY")
+
+
+VIEW_FUNCS = {"matrix": view_matrix, "timeline": view_timeline, "risk": view_risk, "seal": view_seal}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description="Read-only audit dashboard")
+    parser.add_argument("bundle", help="path to evidence bundle JSON")
+    parser.add_argument("--view", choices=VIEWS + ("all",), default="all")
+    args = parser.parse_args(argv)
+    try:
+        bundle = load_bundle(args.bundle)
+    except (OSError, json.JSONDecodeError) as exc:
+        print(f"error: cannot load bundle: {exc}", file=sys.stderr)
+        return 2
+    selected = VIEWS if args.view == "all" else (args.view,)
+    try:
+        for name in selected:
+            VIEW_FUNCS[name](bundle)
+    except BrokenPipeError:
+        return 0
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
