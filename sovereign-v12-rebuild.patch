+name: Skill & Layout Checks
+
+on:
+  push:
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  checks:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Install test dependencies
+        run: python3 -m pip install --quiet pytest jsonschema
+
+      - name: Baseline package presence
+        run: |
+          test -f baseline/MASTER_STANDARD.md
+          test -f baseline/BASELINE_PIPELINE.md
+          test -f baseline/RISK_MANAGEMENT_PLAYBOOK.md
+          test -f baseline/memory.yaml
+          test -f baseline/MASTER_ARTIFACT.md
+
+      - name: Inventory listing
+        run: find . -path ./.git -prune -o -type f -print | sort
+
+      - name: Validate skill frontmatter
+        run: python3 scripts/validate_skills.py
+
+      - name: OPA policy tests
+        run: opa test policy/ -v
+
+      - name: Pytest (schema + release gate)
+        run: python3 -m pytest tests/test_evidence_bundle_schema.py tests/test_release_gate.py -v
+
+      - name: Release gate fail-closed self-test (placeholder must DENY)
+        run: |
+          OUTPUT=$(python3 tools/release/gate_check.py examples/placeholder_evidence_bundle.json 2>&1 || true)
+          echo "$OUTPUT"
+          echo "$OUTPUT" | grep -q "DENY"
